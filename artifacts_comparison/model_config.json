      "severe_toxic": 0.61,
      "obscene": 0.69,
      "threat": 0.88,
      "insult": 0.67,
      "identity_hate": 0.75
    },
    "textcnn": {
      "toxic": 0.74,
      "severe_toxic": 0.8,
      "obscene": 0.56,
      "threat": 0.92,
      "insult": 0.68,
      "identity_hate": 0.87
